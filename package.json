{
  "name": "peekinside",
  "version": "1.3.1",
  "description": "Debug Node.js from the inside, like Laravel Telescope: every error with the request, queries, logs and jobs behind it, for Express, NestJS, Fastify, Koa and Hono. A free local dashboard, and encrypted monitoring for production",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "peekinside": "bin/peekinside.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "demo": "node examples/demo.js",
    "test": "node --test",
    "test:types": "tsc -p test-d && tsc -p test-d/tsconfig.bundler.json && tsc -p test-d/tsconfig.cjs.json",
    "prepublishOnly": "npm test && npm run test:types"
  },
  "keywords": [
    "peekinside",
    "nodejs",
    "debugging",
    "debugger",
    "debugging-tool",
    "telescope",
    "laravel-telescope",
    "dashboard",
    "devtools",
    "http",
    "request-logger",
    "inspector",
    "error-tracking",
    "exceptions",
    "monitoring",
    "observability",
    "apm",
    "express",
    "koa",
    "fastify",
    "nestjs",
    "hono",
    "middleware",
    "prisma",
    "mongoose",
    "sql",
    "n+1",
    "logging",
    "pino",
    "winston",
    "cron",
    "bullmq"
  ],
  "author": "Jesbin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejesbin/peekinside.git"
  },
  "bugs": {
    "url": "https://github.com/thejesbin/peekinside/issues",
    "email": "support@peekinside.dev"
  },
  "homepage": "https://www.peekinside.dev",
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@types/express": "4.17.25",
    "@types/koa": "2.15.0",
    "@types/node": "24.10.1",
    "bullmq": "6.3.14",
    "cron": "4.4.0",
    "express": "4.22.3",
    "express5": "npm:express@5.1.0",
    "fastify": "5.12.5",
    "hono": "4.13.13",
    "koa": "2.16.4",
    "mongodb": "6.21.0",
    "mongodb-memory-server-core": "11.3.0",
    "mongoose": "8.24.5",
    "mysql2": "3.24.5",
    "node-cron": "4.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "winston": "3.19.0"
  }
}
